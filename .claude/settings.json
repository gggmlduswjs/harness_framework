{
  "permissions": {
    "allow": [
      "Bash(uv run --no-project --quiet python scripts/baden_report.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules_reload.py\" || exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_dangerous.py\" || { rc=$?; [ $rc -eq 2 ] || echo \"block_dangerous: 인터프리터 실패(exit $rc) — 안전을 위해 막음\" >&2; exit 2; }"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/scripts/hooks/tdd_guard.py\" || { rc=$?; echo \"tdd_guard: 인터프리터 실패(exit $rc) — 안전을 위해 막음\" >&2; exit 2; }"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/scripts/hooks/audit_log.py\" || exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop_verify.py\" || exit 0",
            "timeout": 40
          },
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/scripts/hooks/issue_handoff.py\" || exit 0",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
